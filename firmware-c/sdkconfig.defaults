# CRCibernetica IdeaBoard: ESP32-WROOM-32E, 8 MB flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESPTOOLPY_BAUD_921600B=y

# Main task does the control loop and printf with floats
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Watchdog: if the control loop hangs for 2 s, panic and reboot (motors stop on reset)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=2
CONFIG_ESP_TASK_WDT_PANIC=y

# 1 ms FreeRTOS tick for a precise 5 ms control period
CONFIG_FREERTOS_HZ=1000

# Keep the brownout detector on (low batteries reset the board instead of misbehaving)
CONFIG_ESP_BROWNOUT_DET=y
